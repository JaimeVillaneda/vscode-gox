{
  "name": "gox-utp",
  "displayName": "Gox UTP Language Support",
  "description": "Resaltado de sintaxis y soporte para el lenguaje Gox creado por Jaime Villaneda (UTP).",
  "version": "0.0.1",
  "publisher": "1000932772", 
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png", 
  "repository": {
    "type": "git",
    "url": "https://github.com/JaimeVillaneda/vscode-gox-utp"
  },
  "keywords": [
    "gox",
    "utp",
    "syntax highlighting",
    "language",
    "compiler"
  ],
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "gox",
        "aliases": ["Gox", "gox"],
        "extensions": [".gox"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gox",
        "scopeName": "source.gox",
        "path": "./syntaxes/gox.tmLanguage.json"
      }
    ]
  }
}