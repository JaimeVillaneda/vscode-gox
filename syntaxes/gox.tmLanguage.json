{
  "name": "gox-utp",
  "scopeName": "source.gox",
  "patterns": [
    { "match": "\\b(func|var|const|if|else|while|return|print|break|continue)\\b", "name": "keyword.gox" },
    { "match": "\\b(int|float|char|bool|void)\\b", "name": "storage.type.gox" },
    { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.gox" },
    { "match": "\".*?\"", "name": "string.quoted.double.gox" },
    { "match": "'(.)'", "name": "string.quoted.single.gox" },
    { "match": "\\b[0-9]+(\\.[0-9]+)?\\b", "name": "constant.numeric.gox" },
    { "match": "//.*$", "name": "comment.line.double-slash.gox" },
    { "match": "\\+|\\-|\\*|\\/|%|==|=|<|>|<=|>=|!=", "name": "keyword.operator.gox" }
  ],
  "fileTypes": ["gox"]
}